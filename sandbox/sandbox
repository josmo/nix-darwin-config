#!/usr/bin/env bash
# `sandbox [--env-arg NAME=VALUE]… [agent] [[--] agent args]`: run a coding agent in a smolbento
# sandbox; see README.md.
# Stages your agent config, then runs `bento env run`, which reads ~/.sbxenv.yaml (from dotfiles)
# and then the project's ./sbxenv.yaml. bento comes from PATH.
set -euo pipefail
# This script's folder, for sandbox.md (found through symlinks: a link on PATH, or Nix's link
# into the store).
here=$(dirname "$(realpath "$0")")
# Extra args for the env files (such as a project file's own), before the agent.
extra=()
while [ "${1:-}" = --env-arg ]; do
  [[ ${2:-} == *=* ]] || { echo "sandbox: --env-arg needs NAME=VALUE" >&2; exit 2; }
  extra+=(--env-arg "$2"); shift 2
done
# No agent (nothing, or straight to `--`): Claude.
if [ $# -eq 0 ] || [ "$1" = -- ]; then set -- claude "$@"; fi
agent=$1; shift
[ "${1:-}" != -- ] || shift
# The name names the sandbox (and picks Antigravity's kit below): a plain word, no paths.
[[ $agent =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "sandbox: '$agent' isn't an agent name" >&2; exit 2; }
# Without it a project's sbxenv.yaml would run alone: no kits, signing or staged config.
[ -e "$HOME/.sbxenv.yaml" ] || { echo "sandbox: no ~/.sbxenv.yaml (it comes from dotfiles); see README.md" >&2; exit 2; }

# Stage personal agent config for the agent-config kit, fresh on every launch. Sandboxes see it
# live, read-only, at the same path.
stage=${XDG_DATA_HOME:-$HOME/.local/share}/sandbox/agent-config
# Emptied, not recreated: running sandboxes have this directory mounted.
mkdir -p "$stage" && find "$stage" -mindepth 1 -delete
# One instructions file for every agent: the shipped sandbox notes, then your own *.md files from
# the instructions folder (optional) in name order, each without its leading frontmatter (such
# as Antigravity's `trigger:`) and followed by a blank line.
instructions=${XDG_CONFIG_HOME:-$HOME/.config}/sandbox/instructions
for f in "$here/sandbox.md" "$instructions"/*.md; do
  [ -e "$f" ] || continue
  awk 'NR == 1 && /^---$/ { fm = 1; next } fm { if (/^---$/) fm = 0; next } 1; END { print "" }' "$f"
done > "$stage/AGENTS.md"
# Subagents and commands, in each agent's own format (APM writes both), where they exist.
# stage_dir DIR AGENT: copy DIR (following symlinks) to $stage/AGENT/.
stage_dir() { if [ -d "$1" ]; then mkdir -p "$stage/$2" && cp -RL "$1" "$stage/$2/"; fi; }
stage_dir ~/.claude/agents claude
stage_dir ~/.claude/commands claude
stage_dir ~/.config/opencode/agents opencode
stage_dir ~/.config/opencode/commands opencode
# APM gives OpenCode the Claude frontmatter. The sandbox's older OpenCode rejects its `tools:` (a
# list, not a map), `model:` (`sonnet`, not provider/model) and named `color:`s. Without them a
# subagent gets every tool and the session's model.
for f in "$stage"/opencode/agents/*.md; do
  [ -e "$f" ] || continue
  awk '/^---$/ { n++ } !(n == 1 && /^(tools|model|color):/)' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done

args=(--env-arg "agent=$agent" --env-arg "stage=$stage")
# A workload kit can't be listed for every agent (two workloads clash), so it's passed only for
# its own agent.
if [ "$agent" = antigravity ]; then args+=(--env-arg agentKit=docker.io/sbx/antigravity:latest); fi
args+=(${extra[@]+"${extra[@]}"})
if [ $# -gt 0 ]; then exec bento env run "${args[@]}" -- "$@"; fi
exec bento env run "${args[@]}"
